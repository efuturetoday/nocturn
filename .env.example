# Copy to .env and fill in. .env is gitignored.
OPENAI_BASE_URL=https://your-llm-endpoint.example.com
OPENAI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=your-key-here
# Global default reasoning effort (a per-agent frontmatter `reasoning:` or a per-message value
# overrides it). low|medium|high|xhigh; empty = the endpoint's own default. Endpoint-dependent.
# OPENAI_REASONING_EFFORT=medium

# Spoken sessions (optional, experimental): a SECOND model, one that takes and returns a continuous
# audio stream rather than answering a turn at a time. Leave unset and everything else works; a
# device asking for a spoken session is simply told this daemon has none.
#
# The id below is the one measured to work: it does asynchronous function calling, so a tool call —
# and the approval behind it — does not stop the conversation. Others in the same family do not, and
# a session on one of those is unusable as soon as anything needs your approval.
#
# There is still no default baked into the binary. These ids change often, and the list a key can
# actually reach is not the list in anybody's documentation — check your own account.
# GEMINI_API_KEY=your-key-here
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# Speaker recognition (optional, experimental): the path to a WeSpeaker ResNet34 ONNX checkpoint
# (~26 MB, never committed — *.onnx is gitignored). Unset means whoami always reports an unknown
# speaker, and the daemon says so at startup so that reads as configuration and not as failure.
# Enrol with: nocturn voices add --device <name> <person> <recordings…>
# NOCTURN_SPEAKER_MODEL=/path/to/wespeaker_en_voxceleb_resnet34.onnx

# Recording the uplink (optional): a directory the daemon writes a device's microphone audio to, as
# 16 kHz mono WAV — the format `nocturn voices add` expects. It exists to capture a voice through
# the microphone, room and echo canceller that will later have to recognise it, which a laptop
# microphone cannot stand in for. OFF unless set, because it writes what the room said to disk;
# arming it logs a warning and every file is logged by name.
# NOCTURN_VOICE_CAPTURE=/path/to/recordings

# Out-of-band approvals (optional): wake a paired phone about an UNATTENDED run's Ask via
# native mobile push (Apple APNs). Leave these empty to keep everything on-LAN over the
# WebSocket. The push is only a WAKE — the approve/deny happens in-app over the authenticated
# WebSocket. Set ALL of KEY/KEY_ID/TEAM_ID/BUNDLE_ID to enable.
# NOCTURN_APNS_KEY=/path/to/AuthKey_XXXXXXXXXX.p8   # token-signing key (.p8, PKCS#8 EC)
# NOCTURN_APNS_KEY_ID=XXXXXXXXXX                     # the key's Key ID
# NOCTURN_APNS_TEAM_ID=YYYYYYYYYY                    # your Apple Developer Team ID
# NOCTURN_APNS_BUNDLE_ID=me.itexpert.nocturn         # the app's bundle id (the apns-topic)
# NOCTURN_APNS_PRODUCTION=1                          # 1 = live APNs host, unset = sandbox

# Secret vault (optional): host-owned credentials injected into outgoing requests at the border,
# so the model (and any script/plugin) never sees the bearer. Set the master passphrase to unlock
# (or, on first run, initialize) the encrypted vault at ./nocturn-data/vault.enc. Unset = no vault,
# no injection. An interactive unlock prompt replaces this env in a later slice.
# NOCTURN_MASTER_PASSPHRASE=correct-horse-battery-staple
# Seed credential VALUES (until an interactive add-secret UX exists): NOCTURN_SECRET_<NAME>=value is
# stored in the vault under <name> (lowercased). e.g. NOCTURN_SECRET_GITHUB → secret "github".
# NOCTURN_SECRET_GITHUB=ghp_xxx
# Bind a stored secret to a host in ./nocturn-data/bindings.json (gitignored), e.g.:
#   [{"secret":"github","host":"api.github.com","header":"Authorization","prefix":"Bearer "}]

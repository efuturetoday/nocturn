# Copy to .env and fill in. .env is gitignored.
FREELLM_BASE_URL=https://your-llm-endpoint.example.com
FREELLM_MODEL=gemini-3.5-flash
FREELLM_API_KEY=your-key-here

# Out-of-band approvals (optional): wake a paired phone about an UNATTENDED run's Ask via
# native mobile push (Apple APNs). Leave these empty to keep everything on-LAN over the
# WebSocket. The push is only a WAKE — the approve/deny happens in-app over the authenticated
# WebSocket. Set ALL of KEY/KEY_ID/TEAM_ID/BUNDLE_ID to enable.
# NOCTURN_APNS_KEY=/path/to/AuthKey_XXXXXXXXXX.p8   # token-signing key (.p8, PKCS#8 EC)
# NOCTURN_APNS_KEY_ID=XXXXXXXXXX                     # the key's Key ID
# NOCTURN_APNS_TEAM_ID=YYYYYYYYYY                    # your Apple Developer Team ID
# NOCTURN_APNS_BUNDLE_ID=me.itexpert.nocturn         # the app's bundle id (the apns-topic)
# NOCTURN_APNS_PRODUCTION=1                          # 1 = live APNs host, unset = sandbox

# Copy to .env and fill in. .env is gitignored.
FREELLM_BASE_URL=https://your-llm-endpoint.example.com
FREELLM_MODEL=gemini-3.5-flash
FREELLM_API_KEY=your-key-here

# Optional: host-managed Google OAuth (ADR-5) for Gmail read access.
# Register a "Desktop app" OAuth client in Google Cloud; leave CLIENT_ID empty to
# disable. The guest never sees the token — the host injects it at the boundary.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly

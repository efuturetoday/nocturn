# Copy to .env and fill in. .env is gitignored.
FREELLM_BASE_URL=https://your-llm-endpoint.example.com
FREELLM_MODEL=gemini-3.5-flash
FREELLM_API_KEY=your-key-here

# Out-of-band approvals (optional): push an UNATTENDED run's Ask to your phone via
# ntfy. Leave the topics empty to keep everything inline in the TUI. Pick two long,
# hard-to-guess topic names (they are public — security comes from the HMAC token).
# Subscribe NTFY_REQ_TOPIC in the ntfy phone app to receive + approve requests.
NTFY_BASE_URL=https://ntfy.sh
NTFY_REQ_TOPIC=
NTFY_RESP_TOPIC=
# NTFY_TOKEN=   # only for a self-hosted, access-controlled ntfy server

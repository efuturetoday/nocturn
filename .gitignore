# secrets — never commit
.env
.env.*
!.env.example

# build output
/nocturn
/nocturnd
*.test

# model checkpoints — 25-40 MB each, fetched by the operator, never committed. The tests that
# need one skip unless NOCTURN_SPEAKER_MODEL points at it (internal/speaker/testdata/README.md).
*.onnx

# interpreter build cache (wasi-sdk + quickjs-ng checkout; see internal/script/qjs/build.sh)
internal/script/qjs/.buildcache/

# macOS
.DS_Store

# Claude Code: shared project config (.claude/settings.json — plugins + hooks) IS
# committed for all maintainers; personal overrides (permissions) stay local.
.claude/settings.local.json

# local runtime plugins — installed plugins may hold OAuth tokens; never commit them
# (testdata/example documents the format). Anchored so it does not swallow internal/plugin/.
/plugins/

# nocturne workspaces (per-workspace runtime state: mnt data, .skills, grants, vault).
# Anchored so it does not swallow internal/workspace/.
/workspaces/

# App runtime data: chats, the device registry, bearer tokens, per-workspace vaults, voiceprints.
# The glob is deliberate. The anchored /nocturn-data/ missed a second tree somebody had made beside
# it while testing, and what sits in one of these is precisely what must never reach a remote.
/nocturn-data*/

# The embedded web UI: the Angular bundle, copied in from mobile/ by internal/webui/generate.sh.
# Two megabytes of minified chunks whose filenames are content hashes, so committing it would rewrite
# every name on every UI change. Release CI copies in the same artefact the mobile app ships.
# The .gitkeep is committed and load-bearing: `//go:embed all:dist` fails to compile if the pattern
# matches no files, and git will not track an empty directory.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# the reference environment for internal/speaker (torch/torchaudio, dev-only)
/internal/speaker/reference/.venv/

# build artefact of the nested reference module
/internal/onnx/reference/nocturn-onnx-reference

# the agentkit example, built in place by `go build ./...` inside its module
/agentkit/example/example

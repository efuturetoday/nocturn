# secrets — never commit
.env
.env.*
!.env.example

# build output
/nocturn
/nocturnd
*.test

# interpreter build cache (wasi-sdk + quickjs-ng checkout; see internal/script/qjs/build.sh)
internal/script/qjs/.buildcache/

# macOS
.DS_Store

# local runtime plugins — installed plugins may hold OAuth tokens; never commit them
# (testdata/example documents the format). Anchored so it does not swallow internal/plugin/.
/plugins/

# nocturne workspaces (per-workspace runtime state: mnt data, .skills, grants, vault).
# Anchored so it does not swallow internal/workspace/.
/workspaces/

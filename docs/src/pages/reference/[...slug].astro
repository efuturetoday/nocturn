---
// Tier-2 data-driven capability pages. Each entry of the `capabilities` data
// collection renders at /reference/<family>/ inside a full Starlight page
// (sidebar / ToC / search / theme). getStaticPaths returns ONLY the six
// capability family ids, so this route emits exactly
// /reference/http|dns|files|icmp|notify|reminders/ and never collides with the
// sibling Markdown docs pages (/reference/capabilities/, /reference/wasm-abi/,
// /reference/javascript-runtime/) or the deeper /reference/tools/… route.
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CapabilityPage from '../../components/CapabilityPage.astro';

export async function getStaticPaths() {
	const entries = (await getCollection('capabilities')).sort((a, b) => a.id.localeCompare(b.id));
	return entries.map((entry, i) => ({
		params: { slug: entry.id },
		props: {
			entry,
			prev: entries[i - 1]
				? { link: `/reference/${entries[i - 1].id}/`, label: entries[i - 1].data.title }
				: undefined,
			next: entries[i + 1]
				? { link: `/reference/${entries[i + 1].id}/`, label: entries[i + 1].data.title }
				: undefined,
		},
	}));
}

const { entry, prev, next } = Astro.props;
const c = entry.data;
---

<StarlightPage frontmatter={{ title: c.title, description: c.description, prev, next }}>
	<CapabilityPage
		family={c.family}
		intro={c.intro}
		glance={c.glance}
		tools={c.tools}
		cage={c.cage}
		limits={c.limits}
		credentials={c.credentials}
		leakScanning={c.leakScanning}
		sections={c.sections}
	/>
</StarlightPage>

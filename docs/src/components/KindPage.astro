---
// Renderer for one entry of the `kinds` data collection: a gate Kind, with the
// tools that carry it, what a remembered grant looks like, and the limits that
// hold regardless of any approval. Used by src/pages/reference/gate/[...slug].astro.
import { Code } from '@astrojs/starlight/components';
import { marked } from 'marked';
import { slug as ghSlug } from 'github-slugger';

interface ToolRef {
	name: string;
	href: string;
	axis: 'read' | 'write';
	gated: boolean;
	desc?: string;
}

interface Section {
	title: string;
	body: string;
}

interface Props {
	kind: string;
	constant: string;
	intro: string;
	glance: { target: string; policy: string; matcher: string };
	tools: ToolRef[];
	grants: { intro: string; examples: string; lang?: string; notes: string[] };
	limits: string[];
	credentials?: string[];
	leakScanning?: { intro?: string; points: string[] };
	sections?: Section[];
}

const { kind, constant, intro, glance, tools, grants, limits, credentials, leakScanning, sections } =
	Astro.props;

// Inline-Markdown for author-friendly prose fields (`code`, [text](href), **bold**).
const md = (s: string | undefined) => (s ? (marked.parseInline(s) as string) : '');
// Block-Markdown for freeform section bodies + grants.intro (paragraphs + lists render).
const mdBlock = (s: string | undefined) => (s ? (marked.parse(s) as string) : '');

// Stable slugified ids for the freeform section headings, using the SAME slugger
// Starlight uses for Markdown headings (github-slugger), so anchors emitted here
// match what the Markdown pipeline would have produced.
const slug = (s: string) => ghSlug(s);
---

<div set:html={mdBlock(intro)} />

<h2 id="at-a-glance">At a glance</h2>
<table>
	<tbody>
		<tr>
			<td><strong>Kind</strong></td>
			<td>
				<code>{kind}</code> — <code>{constant}</code>
			</td>
		</tr>
		<tr>
			<td><strong>Target</strong></td>
			<td set:html={md(glance.target)} />
		</tr>
		<tr>
			<td><strong>Root policy</strong></td>
			<td set:html={md(glance.policy)} />
		</tr>
		<tr>
			<td><strong>Matcher</strong></td>
			<td set:html={md(glance.matcher)} />
		</tr>
	</tbody>
</table>

<h2 id="tools">Tools</h2>
<ul>
	{
		tools.map((t) => (
			<li>
				<a href={t.href}>
					<code>{t.name}</code>
				</a>{' '}
				<span class={`axis axis--${t.axis}`}>{t.axis}</span>{' '}
				<span class={`gate gate--${t.gated ? 'gated' : 'ungated'}`}>
					{t.gated ? 'gated' : 'ungated'}
				</span>
				{t.desc && (
					<Fragment>
						{' '}
						— <span set:html={md(t.desc)} />
					</Fragment>
				)}
			</li>
		))
	}
</ul>

<h2 id="grants">Grants</h2>
<div set:html={mdBlock(grants.intro)} />
<Code code={grants.examples} lang={grants.lang ?? 'json'} />
{
	grants.notes.length > 0 && (
		<ul>
			{grants.notes.map((n) => (
				<li set:html={md(n)} />
			))}
		</ul>
	)
}

<h2 id="limits">Limits</h2>
<ul>
	{limits.map((l) => <li set:html={md(l)} />)}
</ul>

{
	credentials && (
		<Fragment>
			<h2 id="credentials">Credentials</h2>
			<ul>
				{credentials.map((c) => (
					<li set:html={md(c)} />
				))}
			</ul>
		</Fragment>
	)
}

{
	leakScanning && (
		<Fragment>
			<h2 id="leak-scanning">Leak scanning</h2>
			{leakScanning.intro && <div set:html={mdBlock(leakScanning.intro)} />}
			<ul>
				{leakScanning.points.map((p) => (
					<li set:html={md(p)} />
				))}
			</ul>
		</Fragment>
	)
}

{
	sections &&
		sections.map((s) => (
			<Fragment>
				<h2 id={slug(s.title)}>{s.title}</h2>
				<div set:html={mdBlock(s.body)} />
			</Fragment>
		))
}

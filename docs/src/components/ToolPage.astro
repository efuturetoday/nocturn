---
// Renderer for one entry of the `tools` data collection. Fixed layout: what it
// belongs to and whether it asks → intro → Input → Output → From JavaScript →
// Notes. Used by src/pages/reference/tools/[...slug].astro.
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import { marked } from 'marked';

interface InputRow {
	field: string;
	type: string;
	required: boolean;
	notes: string;
}

interface Props {
	kind: { name: string; href: string; target?: string } | null;
	gated: boolean;
	axis: 'read' | 'write' | 'none';
	intro: string;
	input: InputRow[] | 'none';
	output: string | { text?: string; code?: string; lang?: string; after?: string };
	js: { wrapper: string | null; call: string };
	notes?: string;
}

const { kind, gated, axis, intro, input, output, js, notes } = Astro.props;

// The axis badge DESCRIBES the tool (observe vs change); the gate badge says
// whether calling it can stop for a human. They are independent on purpose —
// file_read is a read and ungated, http_read is a read and still asks.
const axisLabel = axis === 'none' ? null : axis;

// Inline-Markdown for author-friendly prose fields: authors write `code`,
// [text](href), **bold** in the YAML instead of raw HTML.
const md = (s: string | undefined) => (s ? (marked.parseInline(s) as string) : '');
// Block-level, for the fields that hold more than one paragraph. parseInline drops the blank lines
// between them, which turned any multi-paragraph note into one wall of text.
const mdBlock = (s: string | undefined) => (s ? (marked.parse(s) as string) : '');
---

<p>
	<strong>Gate:</strong>{' '}
	<span class={`gate gate--${gated ? 'gated' : 'ungated'}`}>{gated ? 'gated' : 'ungated'}</span>
	{
		gated && kind?.target && (
			<Fragment>
				{' '}
				on <a href={kind.href}>
							<code>{kind.name}</code>
						</a>, target <span set:html={md(kind.target)} />
			</Fragment>
		)
	}
	{
		!gated && kind && (
			<Fragment>
				{' '}
				· belongs to <a href={kind.href}>
							<code>{kind.name}</code>
						</a>
			</Fragment>
		)
	}
	{
		!gated && !kind && (
			<Fragment>
				{' '}
				· no kind, zero authority
			</Fragment>
		)
	}
	{
		axisLabel && (
			<Fragment>
				{' '}
				· <span class={`axis axis--${axisLabel}`}>{axisLabel}</span>
			</Fragment>
		)
	}
</p>

<div set:html={mdBlock(intro)} />

<h2 id="input">Input</h2>
{
	input === 'none' ? (
		<p>None.</p>
	) : (
		<table>
			<thead>
				<tr>
					<th>Field</th>
					<th>Type</th>
					<th>Required</th>
					<th>Notes</th>
				</tr>
			</thead>
			<tbody>
				{input.map((row) => (
					<tr>
						<td>
							<code>{row.field}</code>
						</td>
						<td>{row.type}</td>
						<td>{row.required ? 'yes' : 'no'}</td>
						<td set:html={md(row.notes)} />
					</tr>
				))}
			</tbody>
		</table>
	)
}

<h2 id="output">Output</h2>
{
	typeof output === 'string' ? (
		<div set:html={mdBlock(output)} />
	) : (
		<Fragment>
			{output.text && <div set:html={mdBlock(output.text)} />}
			{output.code && <Code code={output.code} lang={output.lang ?? 'json'} />}
			{output.after && <div set:html={mdBlock(output.after)} />}
		</Fragment>
	)
}

<h2 id="from-javascript">From JavaScript</h2>
{
	js.wrapper ? (
		<Tabs>
			<TabItem label="wrapper (idiomatic)">
				<Code code={js.wrapper} lang="js" />
			</TabItem>
			<TabItem label="nocturn.call">
				<Code code={js.call} lang="js" />
			</TabItem>
		</Tabs>
	) : (
		<Code code={js.call} lang="js" title="nocturn.call" />
	)
}

{
	notes && (
		<Fragment>
			<h2 id="notes">Notes</h2>
			<div set:html={mdBlock(notes)} />
		</Fragment>
	)
}

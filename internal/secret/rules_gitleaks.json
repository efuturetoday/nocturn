[
  {
    "id": "private-key",
    "regex": "-----BEGIN[ A-Z0-9]*PRIVATE KEY-----",
    "keywords": ["-----begin"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "openai-api-key",
    "regex": "sk-(?:proj-)?[A-Za-z0-9_-]{20,}",
    "keywords": ["sk-"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "anthropic-api-key",
    "regex": "sk-ant-[A-Za-z0-9_-]{20,}",
    "keywords": ["sk-ant"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "aws-access-key-id",
    "regex": "AKIA[0-9A-Z]{16}",
    "keywords": ["akia"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "github-pat",
    "regex": "ghp_[0-9A-Za-z]{36}",
    "keywords": ["ghp_"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "github-oauth",
    "regex": "gho_[0-9A-Za-z]{36}",
    "keywords": ["gho_"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "github-fine-grained",
    "regex": "github_pat_[0-9A-Za-z_]{60,}",
    "keywords": ["github_pat_"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "gitlab-pat",
    "regex": "glpat-[0-9A-Za-z_-]{20}",
    "keywords": ["glpat-"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "stripe-secret-key",
    "regex": "sk_live_[0-9A-Za-z]{24,}",
    "keywords": ["sk_live_"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "slack-token",
    "regex": "xox[baprs]-[0-9A-Za-z-]{10,}",
    "keywords": ["xox"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "google-api-key",
    "regex": "AIza[0-9A-Za-z_-]{35}",
    "keywords": ["aiza"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "sendgrid-api-key",
    "regex": "SG\\.[0-9A-Za-z_-]{22}\\.[0-9A-Za-z_-]{43}",
    "keywords": ["sg."],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "npm-access-token",
    "regex": "npm_[0-9A-Za-z]{36}",
    "keywords": ["npm_"],
    "entropy": 0,
    "action": "block"
  },
  {
    "id": "jwt",
    "regex": "eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
    "keywords": ["eyj"],
    "entropy": 0,
    "action": "redact"
  },
  {
    "id": "generic-assigned-secret",
    "regex": "(?i)(?:secret|token|passwd|password|api[_-]?key)[\"' ]{0,4}[:=][\"' ]{0,4}[0-9A-Za-z._+/=-]{16,}",
    "keywords": [
      "secret",
      "token",
      "passwd",
      "password",
      "apikey",
      "api_key",
      "api-key"
    ],
    "entropy": 3.5,
    "action": "warn"
  }
]
